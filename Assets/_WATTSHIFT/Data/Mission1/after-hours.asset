  Title: "\u041F\u043E\u0441\u043B\u0435 \u0437\u0430\u043D\u044F\u0442\u0438\u0439"
  Description: "\u0421\u043D\u0438\u0437\u044C\u0442\u0435 \u0432\u0435\u0447\u0435\u0440\u043D\u0435\u0435
    \u043F\u043E\u0442\u0440\u0435\u0431\u043B\u0435\u043D\u0438\u0435 \u0448\u043A\u043E\u043B\u044B,
    \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u0432 \u043F\u0438\u0442\u0430\u043D\u0438\u0435
    \u043F\u043E\u043B\u0438\u043A\u043B\u0438\u043D\u0438\u043A\u0438 \u0438 \u043A\u043E\u043C\u0444\u043E\u0440\u0442
    \u043A\u0432\u0430\u0440\u0442\u0430\u043B\u0430."
  Assumptions: "\u0423\u0447\u0435\u0431\u043D\u044B\u0435 \u043F\u0440\u0438\u043C\u0435\u0440\u043D\u044B\u0435
    \u043D\u0430\u0433\u0440\u0443\u0437\u043A\u0438; \u0440\u0430\u0441\u0445\u043E\u0434\u044B
    \u2014 \u0443\u0441\u043B\u043E\u0432\u043D\u044B\u0435 \u0435\u0434\u0438\u043D\u0438\u0446\u044B.
    \u043A\u0412\u0442: \u043C\u043E\u0449\u043D\u043E\u0441\u0442\u044C \u0432 20:00;
    \u043A\u0412\u0442\xB7\u0447: \u044D\u043D\u0435\u0440\u0433\u0438\u044F \u043F\u043E
    \u0440\u0430\u0441\u043F\u0438\u0441\u0430\u043D\u0438\u044F\u043C \u0437\u0430
    17:00\u201323:00."
