  Events:
  - Id: start
    Hour: 17
    Text: "\u0421\u043A\u043E\u0440\u043E \u0441\u0442\u0435\u043C\u043D\u0435\u0435\u0442.
      \u041D\u0430\u0439\u0434\u0438\u0442\u0435 \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u044B
      \u0438 \u043F\u0435\u0448\u0435\u0445\u043E\u0434\u043D\u044B\u0435 \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u044B."
  - Id: lights-on
    Hour: 18
    Text: "\u0424\u043E\u043D\u0430\u0440\u0438 \u0432\u043A\u043B\u044E\u0447\u0438\u043B\u0438\u0441\u044C:
      \u0438\u0441\u0441\u043B\u0435\u0434\u0443\u0439\u0442\u0435 \u0433\u0440\u0443\u043F\u043F\u044B
      \u0441\u043A\u0430\u043D\u0435\u0440\u043E\u043C \u0438 \u0441\u0440\u0430\u0432\u043D\u0438\u0442\u0435
      \u0438\u0445 \u043F\u0440\u0438\u043E\u0440\u0438\u0442\u0435\u0442\u044B."
  - Id: quiet-paths
    Hour: 20
    Text: "\u041D\u0430 \u0434\u043E\u0440\u043E\u0436\u043A\u0430\u0445 \u0441\u043D\u0438\u0437\u0438\u043B\u0430\u0441\u044C
      \u0430\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u044C: \u0440\u0435\u0433\u0443\u043B\u0438\u0440\u043E\u0432\u043A\u0430
      \u0434\u043E\u043F\u0443\u0441\u0442\u0438\u043C\u0430 \u0437\u0434\u0435\u0441\u044C,
      \u043D\u043E \u043D\u0435 \u043D\u0430 \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0430\u0445."
  - Id: safety-check
    Hour: 22
    Text: "\u041F\u0440\u043E\u0432\u0435\u0440\u044C\u0442\u0435, \u0447\u0442\u043E
      \u0441\u0432\u0435\u0442 \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u043E\u0432
      \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u0435\u0442\u0441\u044F, \u0430
      \u0434\u043E\u0440\u043E\u0436\u043A\u0438 \u043D\u0435 \u043F\u043E\u0433\u0430\u0441\u043B\u0438."
  - Id: end
    Hour: 23
    Text: "\u0421\u043C\u0435\u043D\u0430 \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u043B\u0430\u0441\u044C.
      \u0421\u0440\u0430\u0432\u043D\u0438\u0442\u0435 \u044D\u043A\u043E\u043D\u043E\u043C\u0438\u044E
      \u0441 \u0441\u043E\u0445\u0440\u0430\u043D\u0451\u043D\u043D\u043E\u0439 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044C\u044E."
