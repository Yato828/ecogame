  Events:
  - Id: start
    Hour: 17
    Text: "\u041D\u0430\u0447\u0430\u043B\u043E \u0441\u043C\u0435\u043D\u044B. \u041E\u0441\u043C\u043E\u0442\u0440\u0438\u0442\u0435
      \u0440\u0430\u0439\u043E\u043D \u0438 \u0437\u0430\u043F\u043E\u043C\u043D\u0438\u0442\u0435
      \u0432\u0430\u0436\u043D\u044B\u0435 \u0441\u043B\u0443\u0436\u0431\u044B."
  - Id: after-class
    Hour: 17
    Text: "\u0417\u0430\u043D\u044F\u0442\u0438\u044F \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u043B\u0438\u0441\u044C,
      \u043D\u043E \u0441\u043F\u0440\u043E\u0441 \u0448\u043A\u043E\u043B\u044B
      \u043D\u0435 \u0441\u043D\u0438\u0437\u0438\u043B\u0441\u044F. \u041E\u0431\u0441\u043B\u0435\u0434\u0443\u0439\u0442\u0435
      \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A \u0441\u043A\u0430\u043D\u0435\u0440\u043E\u043C."
  - Id: observe
    Hour: 20
    Text: "\u0412\u0435\u0447\u0435\u0440\u043D\u0438\u0439 \u043F\u0438\u043A: \u0441\u0440\u0430\u0432\u043D\u0438\u0442\u0435
      \u0440\u0430\u0431\u043E\u0442\u0443 \u0448\u043A\u043E\u043B\u044B \u0434\u043E
      \u0438 \u043F\u043E\u0441\u043B\u0435 \u0432\u043C\u0435\u0448\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430."
  - Id: review
    Hour: 22
    Text: "\u0414\u043E \u043A\u043E\u043D\u0446\u0430 \u0441\u043C\u0435\u043D\u044B
      \u0447\u0430\u0441. \u041F\u043E\u0437\u0434\u043D\u0435\u0435 \u0440\u0435\u0448\u0435\u043D\u0438\u0435
      \u0443\u0436\u0435 \u043D\u0435 \u043E\u0442\u043C\u0435\u043D\u0438\u0442
      \u0438\u0437\u0440\u0430\u0441\u0445\u043E\u0434\u043E\u0432\u0430\u043D\u043D\u0443\u044E
      \u044D\u043D\u0435\u0440\u0433\u0438\u044E."
  - Id: end
    Hour: 23
    Text: "\u0421\u043C\u0435\u043D\u0430 \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u043B\u0430\u0441\u044C.
      \u041F\u043E\u0434\u0432\u0435\u0434\u0438\u0442\u0435 \u0438\u0442\u043E\u0433\u0438
      \u043F\u043E \u0444\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0439
      \u044D\u043D\u0435\u0440\u0433\u0438\u0438 \u0438 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438."
