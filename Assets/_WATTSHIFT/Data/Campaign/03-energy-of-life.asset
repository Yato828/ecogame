  Id: energy-of-life-v3
  Title: "\u042D\u043D\u0435\u0440\u0433\u0438\u044F \u0436\u0438\u0437\u043D\u0438"
  Description: "\u0420\u0430\u0437\u0434\u0435\u043B\u0438\u0442\u0435 \u043D\u0430\u0433\u0440\u0443\u0437\u043A\u0438
    \u043F\u043E\u043B\u0438\u043A\u043B\u0438\u043D\u0438\u043A\u0438 \u043F\u043E
    \u043F\u0440\u0438\u043E\u0440\u0438\u0442\u0435\u0442\u0443. \u0423\u0431\u0435\u0440\u0438\u0442\u0435
    \u0438\u0437\u0431\u044B\u0442\u043E\u0447\u043D\u043E\u0435 \u043F\u043E\u0442\u0440\u0435\u0431\u043B\u0435\u043D\u0438\u0435,
    \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u044F \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u0443\u044E
    \u0440\u0430\u0431\u043E\u0442\u0443 \u0443\u0447\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u044F."
  Assumptions: "\u0423\u0447\u0435\u0431\u043D\u044B\u0435 \u043F\u0440\u0438\u043C\u0435\u0440\u043D\u044B\u0435
    \u043D\u0430\u0433\u0440\u0443\u0437\u043A\u0438, \u0440\u0430\u0441\u0445\u043E\u0434\u044B
    \u0432 \u0443\u0441\u043B\u043E\u0432\u043D\u044B\u0445 \u0435\u0434\u0438\u043D\u0438\u0446\u0430\u0445;
    \u0440\u0430\u0441\u043F\u0438\u0441\u0430\u043D\u0438\u044F \u0438 \u043A\u043E\u044D\u0444\u0444\u0438\u0446\u0438\u0435\u043D\u0442\u044B
    \u043D\u0435 \u044F\u0432\u043B\u044F\u044E\u0442\u0441\u044F \u0440\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0430\u0446\u0438\u0435\u0439
    \u0434\u043B\u044F \u0440\u0435\u0430\u043B\u044C\u043D\u044B\u0445 \u043E\u0431\u044A\u0435\u043A\u0442\u043E\u0432."
