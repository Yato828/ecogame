  m_Name: 01-evening-peak
  m_EditorClassIdentifier: Wattshift.Runtime::Wattshift.MissionDefinition
  Id: evening-peak-v3
  Title: "\u0412\u0435\u0447\u0435\u0440\u043D\u0438\u0439 \u043F\u0438\u043A"
  Description: "\u041F\u043E\u0441\u043B\u0435 \u0437\u0430\u043D\u044F\u0442\u0438\u0439
    \u043D\u0430\u0439\u0434\u0438\u0442\u0435 \u0438\u0437\u0431\u044B\u0442\u043E\u0447\u043D\u0443\u044E
    \u043D\u0430\u0433\u0440\u0443\u0437\u043A\u0443 \u0448\u043A\u043E\u043B\u044B.
    \u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u043F\u043E\u0434\u0445\u043E\u0434\u044F\u0449\u0438\u0435
    \u043C\u0435\u0440\u044B \u0438 \u043F\u0440\u043E\u0432\u0435\u0440\u044C\u0442\u0435
    \u0438\u0445 \u0440\u0435\u0430\u043B\u044C\u043D\u044B\u0439 \u044D\u0444\u0444\u0435\u043A\u0442
    \u0437\u0430 \u0441\u043C\u0435\u043D\u0443."
  Assumptions: "\u0423\u0447\u0435\u0431\u043D\u044B\u0435 \u043F\u0440\u0438\u043C\u0435\u0440\u043D\u044B\u0435
    \u043D\u0430\u0433\u0440\u0443\u0437\u043A\u0438, \u0440\u0430\u0441\u0445\u043E\u0434\u044B
    \u0432 \u0443\u0441\u043B\u043E\u0432\u043D\u044B\u0445 \u0435\u0434\u0438\u043D\u0438\u0446\u0430\u0445;
    \u0440\u0430\u0441\u043F\u0438\u0441\u0430\u043D\u0438\u044F \u0438 \u043A\u043E\u044D\u0444\u0444\u0438\u0446\u0438\u0435\u043D\u0442\u044B
    \u043D\u0435 \u044F\u0432\u043B\u044F\u044E\u0442\u0441\u044F \u0440\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0430\u0446\u0438\u0435\u0439
    \u0434\u043B\u044F \u0440\u0435\u0430\u043B\u044C\u043D\u044B\u0445 \u043E\u0431\u044A\u0435\u043A\u0442\u043E\u0432."
  StartHour: 17
  EndHour: 23
